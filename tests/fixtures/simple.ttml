<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" ttp:profile="http://www.w3.org/ns/ttml/profile/dfxp-full" ttp:timeBase="media" xml:lang="en">
  <head>
    <metadata>
      <ttm:title>TTML Document</ttm:title>
    </metadata>
    <styling>
      <style tts:color="white" tts:fontFamily="sansSerif" tts:fontSize="100%" xml:id="default"/>
      <style tts:color="yellow" tts:fontStyle="italic" tts:fontWeight="bold" xml:id="emphasis"/>
    </styling>
    <layout>
      <region tts:displayAlign="after" tts:extent="80% 15%" tts:origin="10% 80%" xml:id="bottom"/>
      <region tts:displayAlign="before" tts:extent="80% 15%" tts:origin="10% 10%" xml:id="top"/>
    </layout>
  </head>
  <body>
    <div>
      <p begin="00:00:00.000" end="00:00:03.000" region="bottom" style="Default">This is a simple line of text.</p>
      <p begin="00:00:03.000" end="00:00:06.000" region="bottom" style="Bold">This text is bold.</p>
      <p begin="00:00:06.000" end="00:00:09.000" region="bottom" style="Italic">This text is italic.</p>
      <p begin="00:00:09.000" end="00:00:12.000" region="bottom" style="RedText">This text is red.</p>
      <p begin="00:00:12.000" end="00:00:15.000" region="bottom" style="Default">
        <span tts:fontWeight="bold">Inline bold</span>
         formatting.
      </p>
      <p begin="00:00:15.000" end="00:00:18.000" region="bottom" style="Default">
        <span tts:fontStyle="italic">Inline italic</span>
         formatting.
      </p>
      <p begin="00:00:18.000" end="00:00:21.000" region="bottom" style="Default">
        <span tts:color="#ff0000">Red</span>
         and 
        <span tts:color="#00ff00">green</span>
         text.
      </p>
      <p begin="00:00:21.000" end="00:00:24.000" region="bottom" style="Default">
        Text with
        <br/>
        line break.
      </p>
      <p begin="00:00:24.000" end="00:00:27.000" region="bottom" style="Default">
        <span tts:fontSize="27px">Larger text</span>
         here.
      </p>
      <p begin="00:00:27.000" end="00:00:30.000" region="bottom" style="Default">
        <span tts:color="#ff0000" tts:fontSize="18px">Big red</span>
         and 
        <span tts:color="#0000ff" tts:fontSize="13px">small blue</span>
         text.
      </p>
      <p begin="00:00:30.000" end="00:00:33.000" region="bottom" style="BoldRed">Bold red text.</p>
      <p begin="00:00:33.000" end="00:00:36.000" region="bottom" style="RedLarge">Large red text.</p>
      <p begin="00:00:36.000" end="00:00:39.000" region="bottom" style="ItalicRed">Italic red text.</p>
      <p begin="00:00:39.000" end="00:00:42.000" region="bottom" style="BoldLargeRed">Bold large red text.</p>
      <p begin="00:00:42.000" end="00:00:45.000" region="bottom" style="ItalicLarge">Italic large text.</p>
      <p begin="00:00:45.000" end="00:00:48.000" region="bottom" style="BoldLarge">Bold large text.</p>
      <p begin="00:00:48.000" end="00:00:51.000" region="bottom" style="Default">Final test line.</p>
    </div>
  </body>
</tt>
