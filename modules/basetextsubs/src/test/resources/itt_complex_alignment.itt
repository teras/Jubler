<?xml version="1.0" encoding="UTF-8"?>
<tt xml:lang="en" xmlns="http://www.w3.org/ns/ttml" xmlns:tts="http://www.w3.org/ns/ttml#styling">
  <head>
    <layout>
      <region xml:id="bottom" tts:origin="10% 80%" tts:extent="80% 15%" tts:textAlign="center" tts:displayAlign="after"/>
      <region xml:id="top" tts:origin="10% 10%" tts:extent="80% 15%" tts:textAlign="center" tts:displayAlign="before"/>
      <region xml:id="center" tts:origin="10% 40%" tts:extent="80% 20%" tts:textAlign="center" tts:displayAlign="center"/>
      <region xml:id="topleft" tts:origin="10% 10%" tts:extent="80% 15%" tts:textAlign="start" tts:displayAlign="before"/>
      <region xml:id="topright" tts:origin="10% 10%" tts:extent="80% 15%" tts:textAlign="end" tts:displayAlign="before"/>
      <region xml:id="left" tts:origin="10% 40%" tts:extent="80% 20%" tts:textAlign="start" tts:displayAlign="center"/>
      <region xml:id="right" tts:origin="10% 40%" tts:extent="80% 20%" tts:textAlign="end" tts:displayAlign="center"/>
      <region xml:id="bottomleft" tts:origin="10% 80%" tts:extent="80% 15%" tts:textAlign="start" tts:displayAlign="after"/>
      <region xml:id="bottomright" tts:origin="10% 80%" tts:extent="80% 15%" tts:textAlign="end" tts:displayAlign="after"/>
    </layout>
    <styling>
      <style xml:id="defaultStyle" tts:fontFamily="Arial" tts:fontSize="20px" tts:color="#FFFFFF"/>
    </styling>
  </head>
  <body>
    <div>
      <p xml:id="sub1" begin="00:00:01.000" end="00:00:03.000" region="topleft">Top-left region</p>
      <p xml:id="sub2" begin="00:00:04.000" end="00:00:06.000" region="top">Top region</p>
      <p xml:id="sub3" begin="00:00:07.000" end="00:00:09.000" region="topright">Top-right region</p>
      <p xml:id="sub4" begin="00:00:10.000" end="00:00:12.000" region="left">Left region</p>
      <p xml:id="sub5" begin="00:00:13.000" end="00:00:15.000" region="center">Center region</p>
      <p xml:id="sub6" begin="00:00:16.000" end="00:00:18.000" region="right">Right region</p>
      <p xml:id="sub7" begin="00:00:19.000" end="00:00:21.000" region="bottomleft">Bottom-left region</p>
      <p xml:id="sub8" begin="00:00:22.000" end="00:00:24.000" region="bottom">Bottom region (explicit)</p>
      <p xml:id="sub9" begin="00:00:25.000" end="00:00:27.000" region="bottomright">Bottom-right region</p>
      <p xml:id="sub10" begin="00:00:28.000" end="00:00:30.000">No region (uses default style = BOTTOM)</p>
    </div>
  </body>
</tt>
