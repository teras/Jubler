<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" ttp:timeBase="media" xml:lang="en">
  <head/>
  <body>
    <div>
      <p begin="00:00:01.000" end="00:00:04.000">This is a simple line of text.</p>
      <p begin="00:00:05.000" end="00:00:08.000">This text is bold.</p>
      <p begin="00:00:09.000" end="00:00:12.000">This text is italic.</p>
      <p begin="00:00:13.000" end="00:00:16.000">This text is red.</p>
      <p begin="00:00:17.000" end="00:00:20.000">Inline bold formatting.</p>
      <p begin="00:00:21.000" end="00:00:24.000">Inline italic formatting.</p>
      <p begin="00:00:25.000" end="00:00:28.000">Red and green text.</p>
      <p begin="00:00:29.000" end="00:00:32.000">Text with
line break.</p>
      <p begin="00:00:33.000" end="00:00:36.000">Larger text here.</p>
      <p begin="00:00:37.000" end="00:00:40.000">Final test line.</p>
    </div>
  </body>
</tt>
