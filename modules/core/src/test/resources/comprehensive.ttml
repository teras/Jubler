<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" ttp:timeBase="media" xml:lang="en">
  <head/>
  <body>
    <div>
      <p begin="00:00:01.000" end="00:00:04.000">This is a basic subtitle line with default styling.</p>
      <p begin="00:00:05.000" end="00:00:08.000" tts:fontWeight="bold">This line uses the Bold style.</p>
      <p begin="00:00:09.000" end="00:00:12.000" tts:fontStyle="italic">This line uses the Italic style.</p>
      <p begin="00:00:13.000" end="00:00:16.000" tts:color="#ff0000">This line appears in red color.</p>
      <p begin="00:00:17.000" end="00:00:20.000" tts:fontSize="37px">This is larger text.</p>
      <p begin="00:00:21.000" end="00:00:24.000">This appears at the top center.</p>
      <p begin="00:00:25.000" end="00:00:28.000">This appears at bottom left.</p>
      <p begin="00:00:29.000" end="00:00:32.000">This text has a shadow effect.</p>
      <p begin="00:00:33.000" end="00:00:36.000">
        <span tts:fontWeight="bold">Inline bold text</span> mixed with normal text.</p>
      <p begin="00:00:37.000" end="00:00:40.000">
        <span tts:fontStyle="italic">Inline italic text</span> and <span tts:textDecoration="underline">underlined text</span>.</p>
      <p begin="00:00:41.000" end="00:00:44.000">
        <span tts:color="#ff0000">Red text<span tts:color="#000000"> and <span tts:color="#00ff00">green text<span tts:color="#000000">.</span>
            </span>
          </span>
        </span>
      </p>
      <p begin="00:00:45.000" end="00:00:48.000">
        <span tts:fontSize="36px">Large text<span tts:fontSize="0px"> and <span tts:fontSize="15px">small text<span tts:fontSize="0px">.</span>
            </span>
          </span>
        </span>
      </p>
      <p begin="00:00:49.000" end="00:00:52.000">Text with fade in and out effect.</p>
      <p begin="00:00:53.000" end="00:00:56.000">Moving text animation.</p>
      <p begin="00:00:57.000" end="00:01:00.000">
        <span tts:fontSize="0px">Text that grows in size.</span>
      </p>
      <p begin="00:01:01.000" end="00:01:04.000">Top-left aligned text.</p>
      <p begin="00:01:05.000" end="00:01:08.000">Bottom-right aligned text.</p>
      <p begin="00:01:09.000" end="00:01:12.000">
        <span tts:fontFamily=" Comic Sans MS">Different font family.</span>
      </p>
      <p begin="00:01:13.000" end="00:01:16.000">Text with <span tts:color="#ffffff">transparency effect<span tts:color="#ffffff">.</span>
        </span>
      </p>
      <p begin="00:01:17.000" end="00:01:20.000">Thick border and shadow.</p>
      <p begin="00:01:21.000" end="00:01:24.000">Horizontally stretched text.</p>
      <p begin="00:01:25.000" end="00:01:28.000">Vertically stretched text.</p>
      <p begin="00:01:29.000" end="00:01:32.000">Rotated text at 45 degrees.</p>
      <p begin="00:01:33.000" end="00:01:36.000">Blurred text effect.</p>
      <p begin="00:01:37.000" end="00:01:40.000">This is a line<br/>with a line break.</p>
      <p begin="00:01:41.000" end="00:01:44.000">Karaoke timing.</p>
      <p begin="00:01:45.000" end="00:01:48.000">Text with colored outline.</p>
      <p begin="00:01:49.000" end="00:01:52.000">Colored shadow effect.</p>
      <p begin="00:01:53.000" end="00:01:56.000">Multiple <span tts:fontWeight="bold">
          <span tts:fontStyle="italic">
            <span tts:textDecoration="underline">combined</span>
          </span>
        </span> formatting tags.</p>
      <p begin="00:01:57.000" end="00:02:00.000">Spinning text around center.</p>
      <p begin="00:02:05.000" end="00:02:08.000">Final test line with normal formatting.</p>
    </div>
  </body>
</tt>
