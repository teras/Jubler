<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.panayotis.jubler</groupId>
        <artifactId>project</artifactId>
        <version>9.0.0-ALPHA</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <artifactId>installer</artifactId>
    <packaging>pom</packaging>
    <dependencies>
        <dependency>
            <groupId>com.panayotis.jubler</groupId>
            <artifactId>jubler</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.panayotis.jubler</groupId>
            <artifactId>aspell</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.panayotis.jubler</groupId>
            <artifactId>autoupdate</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.panayotis.jubler</groupId>
            <artifactId>basetextsubs</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.panayotis.jubler</groupId>
            <artifactId>coretools</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.panayotis.jubler</groupId>
            <artifactId>mplayer</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.panayotis.jubler</groupId>
            <artifactId>zemberek</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.panayotis.jubler</groupId>
            <artifactId>azuretranslate</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.panayotis.jubler</groupId>
            <artifactId>coretheme</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.panayotis.jubler</groupId>
            <artifactId>vlcj-jubler</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>2.10</version>
                <executions>
                    <execution>
                        <id>copy-dependencies</id>
                        <phase>install</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>target/jubler/lib</outputDirectory>
                            <excludeArtifactIds>jupidator-project,project</excludeArtifactIds>
                        </configuration>
                    </execution>
                </executions>
                <configuration>
                    <overWriteReleases>false</overWriteReleases>
                    <overWriteSnapshots>true</overWriteSnapshots>
                    <addParentPoms>true</addParentPoms>
                    <stripVersion>true</stripVersion>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>copy-i18n</id>
                        <configuration>
                            <target>
                                <copy todir="target/jubler/lib/i18n">
                                    <fileset dir="../../resources/i18n">
                                        <include name="*.json"/>
                                    </fileset>
                                </copy>
                                <copy file="../../resources/help/cache/jubler-faq.html" todir="target/jubler/lib/help"/>
                                <copy file="../../resources/help/question.png" todir="target/jubler/lib/help"/>
                                <copy file="../../README.md" tofile="target/jubler/README.md"/>
                                <copy file="../../LICENCE" tofile="target/jubler/LICENCE.txt"/>
                            </target>
                        </configuration>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <phase>compile</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <properties>
        <mac.dist/>
        <win32.dist/>
        <win64.dist/>
        <linux.dist/>
        <generic.dist/>
        <arm32.dist/>
        <arm64.dist/>
        <makeapp.ext>linux</makeapp.ext>
    </properties>

    <profiles>
        <profile>
            <id>build-under-macos</id>
            <activation>
                <os>
                    <family>mac</family>
                </os>
            </activation>
            <properties>
                <makeapp.ext>mac</makeapp.ext>
            </properties>
        </profile>
        <profile>
            <id>nosign</id>
            <properties>
                <app.nosign>win32,win64,macos</app.nosign>
            </properties>
        </profile>
        <profile>
            <id>macos</id>
            <properties>
                <mac.dist>macos</mac.dist>
            </properties>
        </profile>
        <profile>
            <id>win32</id>
            <properties>
                <win32.dist>win32</win32.dist>
            </properties>
        </profile>
        <profile>
            <id>win64</id>
            <properties>
                <win64.dist>win64</win64.dist>
            </properties>
        </profile>
        <profile>
            <id>linux</id>
            <properties>
                <linux.dist>linux64</linux.dist>
            </properties>
        </profile>
        <profile>
            <id>arm32</id>
            <properties>
                <arm32.dist>linuxarm32</arm32.dist>
            </properties>
        </profile>
        <profile>
            <id>arm64</id>
            <properties>
                <arm64.dist>linuxarm64</arm64.dist>
            </properties>
        </profile>
        <profile>
            <id>generic</id>
            <properties>
                <generic.dist>generic</generic.dist>
            </properties>
        </profile>
    </profiles>
</project>
