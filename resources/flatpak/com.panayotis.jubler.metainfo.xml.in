<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.panayotis.jubler</id>
  <name>Jubler</name>
  <summary>Sync and edit subtitles to video</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>AGPL-3.0-only</project_license>

  <developer id="com.panayotis">
    <name>Panayotis Katsaloulis</name>
  </developer>

  <description>
    <p>
      Jubler creates, edits and converts text-based subtitles. It reads more than twenty
      formats, from SubRip and Advanced SubStation Alpha to WebVTT and TTML, and writes
      back into any of them, so a file prepared for one player can be handed to another.
    </p>
    <p>
      Timing is done against the film itself. A VLC-backed preview plays the video with the
      subtitles over it, while an audio waveform shows where speech actually begins and
      ends, so lines can be placed on it directly.
    </p>
    <p>Its tools include:</p>
    <ul>
      <li>Two-point synchronisation, time shifting and frame rate conversion</li>
      <li>Splitting and joining, of single entries and of whole files</li>
      <li>Spell checking with dictionaries downloaded on demand</li>
      <li>Regular expression find and replace</li>
      <li>Quality validation, including the TED guidelines</li>
      <li>Character and paragraph styling for the formats that carry it</li>
      <li>Side-by-side translation mode</li>
      <li>Subtitle search and download from several providers</li>
    </ul>
  </description>

  <launchable type="desktop-id">com.panayotis.jubler.desktop</launchable>

  <url type="homepage">https://jubler.org</url>
  <url type="bugtracker">https://github.com/teras/Jubler/issues</url>
  <url type="vcs-browser">https://github.com/teras/Jubler</url>
  <url type="contribute">https://github.com/teras/Jubler/blob/master/README.md#contributing</url>

  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/teras/Jubler/@@SCREENSHOT_REF@@/resources/screenshots/welcome.png</image>
      <caption>Welcome screen</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/teras/Jubler/@@SCREENSHOT_REF@@/resources/screenshots/main.png</image>
      <caption>Subtitle table with styling and character-level formatting</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/teras/Jubler/@@SCREENSHOT_REF@@/resources/screenshots/horizontal.png</image>
      <caption>Video preview and audio waveform side by side</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/teras/Jubler/@@SCREENSHOT_REF@@/resources/screenshots/vertical.png</image>
      <caption>Vertical layout with the subtitle list beside the preview</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/teras/Jubler/@@SCREENSHOT_REF@@/resources/screenshots/spellcheck.png</image>
      <caption>Spell checking with Hunspell and downloadable dictionaries</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/teras/Jubler/@@SCREENSHOT_REF@@/resources/screenshots/translate.png</image>
      <caption>Machine translation of a subtitle range</caption>
    </screenshot>
  </screenshots>

  <releases>
@@RELEASES@@
  </releases>

  <branding>
    <color type="primary" scheme_preference="light">#e3c6f5</color>
    <color type="primary" scheme_preference="dark">#3b1d57</color>
  </branding>

  <content_rating type="oars-1.1"/>
</component>
