// This file is part of Jubler.

// The icon and the version information of jubler.exe (configured by CMake).
#include <winver.h>

IDI_ICON1 ICON "@JUBLER_WIN_ICON@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @JUBLER_WIN_VERSION@
PRODUCTVERSION @JUBLER_WIN_VERSION@
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Panayotis Katsaloulis"
            VALUE "FileDescription", "Jubler subtitle editor"
            VALUE "FileVersion", "@JUBLER_VERSION_STRING@"
            VALUE "InternalName", "jubler"
            VALUE "LegalCopyright", "(c) 2005-@JUBLER_YEAR@ Panayotis Katsaloulis, AGPL-3.0"
            VALUE "OriginalFilename", "jubler.exe"
            VALUE "ProductName", "Jubler"
            VALUE "ProductVersion", "@JUBLER_VERSION_STRING@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
